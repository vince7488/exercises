# Headless WordPress: WordPress core is supplied by the runtime, not Git.
/wp-admin/
/wp-includes/

# Root-level WordPress core files.
/index.php
/license.txt
/readme.html
/wp-activate.php
/wp-blog-header.php
/wp-comments-post.php
/wp-config-sample.php
/wp-cron.php
/wp-links-opml.php
/wp-load.php
/wp-login.php
/wp-mail.php
/wp-settings.php
/wp-signup.php
/wp-trackback.php
/xmlrpc.php

# Local/runtime configuration and credentials.
/wp-config.php
/wp-config-*.php
/.htaccess
/php.ini
/.user.ini
/web.config

# WordPress content generated or managed outside this repository.
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/backup*/
/wp-content/cache/
/wp-content/wflogs/
/wp-content/ai1wm-backups/
/wp-content/blogs.dir/
/wp-content/languages/
/wp-content/object-cache.php
/wp-content/advanced-cache.php
/wp-content/db.php
/wp-content/sunrise.php
/wp-content/debug.log

# Third-party WordPress code. Keep only intentionally committed custom code
# (for example, a bespoke theme or must-use plugin) outside these paths.
/wp-content/plugins/
/wp-content/themes/twentytwenty*/

# Dependency, build, package-manager, and editor artifacts.
**/node_modules/
**/vendor/
**/.cache/
**/.sass-cache/
**/dist/
**/build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Environment files and local tool state.
.env
.env.*
!.env.example
.wp-env/
